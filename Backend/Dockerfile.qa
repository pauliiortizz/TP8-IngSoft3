# Dockerfile para QA - Version simplificada para CI/CD
# Usa archivos ya publicados como contexto
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# Exponer puertos
EXPOSE 80
EXPOSE 443

# Copiar archivos ya publicados desde el contexto (./publish)
COPY . .

# Configurar variable de entorno para QA
ENV ASPNETCORE_ENVIRONMENT=QA

ENTRYPOINT ["dotnet", "ProductosApi.dll"]
